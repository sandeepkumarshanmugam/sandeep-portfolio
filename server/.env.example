# ---------------------------------------------------------------------------
# Contact API configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# The API boots without the optional values and reports what is live at
# GET /health — so you can run it locally before any accounts exist.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma-separated origins allowed to call this API.
# Add the production domain here at deploy time.
ALLOWED_ORIGINS=http://localhost:5173

# --- Persistence (optional) ------------------------------------------------
# Postgres connection string. Neon, Supabase and Render all provide one.
# Without it the API validates and emails but stores nothing.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Email (optional) ------------------------------------------------------
# All three are required together for delivery to be enabled.
# Get a key at https://resend.com. CONTACT_FROM_EMAIL must be on a domain
# verified in your Resend account — a Gmail address will not pass SPF/DKIM.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_FROM_EMAIL=contact@yourdomain.com
# CONTACT_TO_EMAIL=sekarsandeep2006@gmail.com

# --- Abuse protection ------------------------------------------------------
# Submissions allowed per IP per window (default: 5 per 10 minutes).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000

# Number of reverse proxies in front of this service. Keep 0 for local dev;
# set to 1 behind Render / Railway / Fly / nginx so req.ip is the real client
# and cannot be spoofed via X-Forwarded-For.
TRUST_PROXY=0
