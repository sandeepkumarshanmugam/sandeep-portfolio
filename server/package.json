{
  "name": "sandeepkumar-portfolio-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Contact API for the portfolio of Sandeepkumar S.",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "tsx": "^4.20.4",
    "typescript": "~5.8.3"
  }
}
