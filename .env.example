# ---------------------------------------------------------------------------
# Frontend configuration
#
# Everything prefixed VITE_ is inlined into the client bundle at build time
# and is therefore PUBLIC. Never put a secret here — API keys, database URLs
# and the Resend key belong in server/.env, which is read only by the API.
# ---------------------------------------------------------------------------

# Base URL of the contact API.
#
# Leave EMPTY for local development: vite.config.ts proxies /api to
# http://localhost:4000, so same-origin requests just work.
#
# In production, set this to the deployed API origin, with no trailing slash:
#   VITE_API_BASE_URL=https://sandeepkumar-api.onrender.com
VITE_API_BASE_URL=
